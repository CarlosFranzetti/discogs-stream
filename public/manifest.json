{
  "manifest_version": 3,
  "name": "Discogs Vinyl Stream",
  "short_name": "VinylStream",
  "version": "2.0.0",
  "description": "Stream your Discogs vinyl collection with marketplace, crates, playlists, and pitch control",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.discogs.com/*",
    "https://api.discogs.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Discogs Vinyl Stream",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.discogs.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "Command+D",
        "default": "Ctrl+D"
      },
      "description": "Open Discogs Vinyl Stream"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "chunks/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
